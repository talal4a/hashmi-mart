{
  "expo": {
    "name": "HashmiMart",
    "slug": "HashmiMart",
    "version": "1.0.0",
    
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00A2D4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00A2D4"
      },
      "package": "com.hashmimart"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "webClientId": "886326794185-qvn3icsb25bg63271ev56p5j51ole4pv.apps.googleusercontent.com"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HashmiMart uses your photos so you can set a profile picture.",
          "cameraPermission": "HashmiMart uses your camera so you can take a profile picture."
        }
      ]
    ]
  }
}
